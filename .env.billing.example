# Backend API only. Copy to ignored .env.billing with permissions 600.
# Do not enable without real Razorpay TEST credentials and reviewed plan bindings.
ORQENTRA_BILLING_PROVIDER=disabled
# RAZORPAY_KEY_ID=rzp_test_REPLACE
# RAZORPAY_KEY_SECRET=replace-with-test-secret
# RAZORPAY_WEBHOOK_SECRET=replace-with-a-strong-webhook-secret
# RAZORPAY_PREVIOUS_WEBHOOK_SECRET=only-during-a-bounded-rotation-window
# ORQENTRA_RAZORPAY_PLAN_IDS={"pilot":"plan_REPLACE"}
# RAZORPAY_PREVIOUS_WEBHOOK_SECRET_EXPIRES_AT=timezone-aware-ISO-expiry-within-48-hours
# ORQENTRA_BILLING_TEST_ACTIONS_ENABLED=false
# ORQENTRA_BILLING_TEST_TOTAL_CYCLES=12
# Test checkout/cancellation require the explicit action flag; production/live payments are refused.
