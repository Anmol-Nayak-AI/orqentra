# Template only. Copy into your secret manager / ignored backend environment file.
# Never reuse local development records, keys or owner database credentials for customers.
ORQENTRA_ENVIRONMENT=production
ORQENTRA_ALLOWED_HOSTS=api.your-company.example
ORQENTRA_DATABASE_URL=postgresql+psycopg://RUNTIME_USER:REPLACE_ME@db.your-company.example/orqentra?sslmode=verify-full&sslrootcert=/run/secrets/database-ca.pem
CLERK_ISSUER=https://clerk.your-company.example
CLERK_ALLOWED_ORIGINS=https://app.your-company.example
# Supply the production Clerk app's RSA PUBLIC signing key from the secret manager.
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# OPENAI_API_KEY=managed-backend-only-key
# Production frontend build uses its own pk_live_ VITE_CLERK_PUBLISHABLE_KEY.
# Migration credentials belong only to the separate migration job.
