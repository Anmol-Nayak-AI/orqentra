# Export explicitly in your shell; the application never auto-loads this file.
ORQENTRA_ENVIRONMENT=development
# Explicit host-only examples (replace placeholders; never use owner credentials for API):
# ORQENTRA_DATABASE_URL=postgresql+psycopg://orqentra_runtime:REPLACE@127.0.0.1:5432/orqentra
# ORQENTRA_MIGRATION_DATABASE_URL=postgresql+psycopg://MIGRATION_OWNER:REPLACE@127.0.0.1:5432/orqentra
# make runtime-setup creates ignored .env.runtime for Compose; API does not auto-read files.
# Never put secret keys in VITE_* variables.
# Clerk options live in root .env.auth for Compose; export explicitly for host API.
# CLERK_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev
# CLERK_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://127.0.0.1:5173
# CLERK_JWT_KEY=your-existing-app-public-RSA-key
# CLERK_AUDIENCE=only-if-configured-in-your-session-JWT

# Maximum API request body bytes (default 65536; nginx also caps requests at 64 KiB).
# ORQENTRA_MAX_REQUEST_BYTES=65536
