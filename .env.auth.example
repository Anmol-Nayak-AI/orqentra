# Copy to .env.auth (ignored, chmod 600) and fill all three from ONE existing Clerk app.
# Use its JWT public signing key, NEVER a private key or Clerk secret key.
# CLERK_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev
# CLERK_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://127.0.0.1:5173
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_PUBLIC_PEM_CONTENT\n-----END PUBLIC KEY-----"
# CLERK_AUDIENCE=only-if-your-session-token-has-this-audience
# ORQENTRA_CLERK_MAX_TOKEN_LIFETIME=300
