{
  "name": "orqentra",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "npm run dev --workspace @orqentra/web",
    "lint": "biome check apps/web/src apps/web/e2e apps/web/vite.config.ts apps/web/playwright.config.ts packages/contracts/src",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @orqentra/web",
    "test:e2e": "npm run test:e2e --workspace @orqentra/web",
    "build": "npm run build --workspace @orqentra/web",
    "contracts:generate": "openapi-typescript packages/contracts/openapi.json -o packages/contracts/src/api.d.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@clerk/shared": "4.43.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
